{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app/(auth)/index.jsx",
    "app/_layout.jsx",
    "app/index.jsx",
    "app/(customerTabs)/_layout.jsx"
  ]
}
